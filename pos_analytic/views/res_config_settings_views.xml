<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_pos_analytic" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos.analytic</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='pos_default_journals']" position="after">
                <setting id="pos_analytic_account_setting"
                         string="Analytic Account"
                         help="Analytic account applied to every accounting entry generated by this point of sale"
                         groups="analytic.group_analytic_accounting">
                    <div class="content-group mt16">
                        <div class="row">
                            <label string="Account" for="pos_analytic_account_id" class="col-lg-3 o_light_label"/>
                            <field name="pos_analytic_account_id"
                                   domain="['|', ('company_id', '=', False), ('company_id', '=', company_id)]"
                                   context="{'default_company_id': company_id}"
                                   options="{'no_create': True}"/>
                        </div>
                        <div class="row" invisible="not pos_analytic_account_id">
                            <label string="Balance sheet lines" for="pos_analytic_all_lines" class="col-lg-3 o_light_label"/>
                            <field name="pos_analytic_all_lines"/>
                        </div>
                        <div class="text-muted" invisible="not pos_analytic_account_id">
                            By default only income, expense and cost of goods sold lines are tagged.
                            Enable "Balance sheet lines" to also tag receivable, cash, bank and stock valuation lines.
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
